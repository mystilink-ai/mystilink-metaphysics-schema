{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mystilink.com/metaphysics/v0/systems/ziwei.chart.schema.json",
  "title": "ZiweiChart",
  "description": "Zi Wei Dou Shu chart facts (mystilink.ziwei.chart/0.1). Palace star lists are string arrays; optional extensions documented.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gender", "ming_gong_branch", "palaces"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mystilink.ziwei.chart/0.1"
    },
    "gender": {
      "type": "string",
      "enum": ["male", "female"]
    },
    "ming_gong_branch": { "type": "string", "minLength": 1 },
    "shen_gong_branch": { "type": "string", "minLength": 1 },
    "midnight_zi_rule": {
      "type": "string",
      "enum": ["same-day", "next-day"]
    },
    "four_pillars": {
      "description": "Four pillars as Ganzhi objects (preferred) or legacy stem+branch strings",
      "oneOf": [
        { "$ref": "../common/ganzhi-pillars.schema.json" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["year", "month", "day", "hour"],
          "properties": {
            "year": { "type": "string", "minLength": 2 },
            "month": { "type": "string", "minLength": 2 },
            "day": { "type": "string", "minLength": 2 },
            "hour": { "type": "string", "minLength": 2 }
          }
        }
      ]
    },
    "palaces": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/palace" }
    },
    "solar_local": { "type": "string" },
    "solar_used_for_lunar": { "type": "string" },
    "true_solar_time_enabled": { "type": "boolean" },
    "true_solar_time_delta_minutes": { "type": ["number", "null"] },
    "yin_yang": { "type": "string" },
    "zodiac": { "type": "string" },
    "lunar": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "year": { "type": "integer" },
        "month": { "type": "integer" },
        "day": { "type": "integer" },
        "leap_month": { "type": "boolean" },
        "year_stem": { "type": "string" },
        "year_branch": { "type": "string" },
        "year_pillar": { "type": "string" }
      }
    },
    "hour_branch": { "type": "string" },
    "ming_zhu": { "type": "string" },
    "shen_zhu": { "type": "string" },
    "ming_gong_pillar": { "type": "string" },
    "na_yin": { "type": "string" },
    "five_element_frame": { "type": "string" },
    "five_element_number": { "type": "integer" },
    "ziwei_branch": { "type": "string" },
    "tianfu_branch": { "type": "string" },
    "calendar_engine": {
      "type": "string",
      "enum": ["builtin", "lunar", "external_basis"]
    },
    "calendar_basis": {
      "type": "object",
      "additionalProperties": true
    },
    "si_hua": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional four transformations block"
    },
    "liunian": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional annual fortune when target year is set"
    }
  },
  "$defs": {
    "palace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["palace_index", "branch", "name"],
      "properties": {
        "palace_index": { "type": "integer", "minimum": 0, "maximum": 11 },
        "branch": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "stem": { "type": "string" },
        "pillar": { "type": "string" },
        "main_stars": {
          "type": "array",
          "items": { "type": "string" }
        },
        "minor_stars": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mini_stars": {
          "type": "array",
          "items": { "type": "string" }
        },
        "life_stage": { "type": "string" },
        "scholar_stage": { "type": "string" },
        "annual_general": { "type": "string" },
        "annual_officer": { "type": "string" },
        "decade_range": { "type": "string" },
        "note": { "type": "string" },
        "yearly_palace_name": {
          "type": "string",
          "description": "Present when chart computed with a target year"
        }
      }
    }
  }
}
