{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mystilink.com/metaphysics/v0/systems/horoscope.natal.schema.json",
  "title": "HoroscopeNatalChart",
  "description": "Draft Western natal chart facts (v0).",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "planets"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mystilink.horoscope.natal/0.1"
    },
    "zodiac_system": {
      "type": "string",
      "enum": ["tropical", "sidereal"],
      "default": "tropical"
    },
    "house_system": {
      "type": "string",
      "description": "House system code, e.g. P for Placidus"
    },
    "planets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "additionalProperties": true }
    },
    "houses": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "aspects": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    }
  }
}
