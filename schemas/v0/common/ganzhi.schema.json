{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mystilink.com/metaphysics/v0/common/ganzhi.schema.json",
  "title": "Ganzhi",
  "description": "One stem-branch pair. Prefer indices for logic; text for display.",
  "type": "object",
  "additionalProperties": false,
  "required": ["stem_index", "branch_index", "stem", "branch", "text"],
  "properties": {
    "stem_index": { "type": "integer", "minimum": 0, "maximum": 9 },
    "branch_index": { "type": "integer", "minimum": 0, "maximum": 11 },
    "stem": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "text": {
      "type": "string",
      "minLength": 2,
      "description": "Concatenation of stem + branch, e.g. 癸酉"
    }
  }
}
