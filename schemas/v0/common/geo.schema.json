{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mystilink.com/metaphysics/v0/common/geo.schema.json",
  "title": "GeoPlace",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "label": {
      "type": "string",
      "description": "Human-readable place label (fictional or generic in examples)"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "East-positive longitude in degrees"
    }
  }
}
